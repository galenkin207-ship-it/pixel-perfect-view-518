[Unit]
Description=Uchet frontend (TanStack Start SSR)
After=network.target uchet-backend.service

[Service]
Type=simple
User=www-data
WorkingDirectory=/opt/uchet/frontend
Environment=PORT=3000
Environment=NODE_ENV=production
ExecStart=/usr/bin/node .output/server/index.mjs
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
